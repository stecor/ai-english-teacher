generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "cockroachdb"
}

model User {
  id           String           @id
  firstName    String?
  lastName     String?
  email        String?          @unique
  image        String?
  createdAt    DateTime         @default(now()) @db.Timestamp(6)
  updatedAt    DateTime         @default(now()) @updatedAt @db.Timestamp(6)
  imageUrl     String?
  chats        Chat[]
  UserApiLimit UserApiLimit?
  preferences  UserPreferences?
}

model UserPreferences {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @unique
  nativeLanguage        String   @default("Portuguese")
  learningLanguage      String   @default("English")
  englishLevel          String   @default("BEGINNER")
  learningGoal          String?  @default("GENERAL_ENGLISH")
  dailyGoalMinutes      Int   @default(15)
  dailyGoalLessons      Int   @default(1)
  lessonDifficulty      String   @default("ADAPTIVE")
  lessonLengthMinutes   Int   @default(15)
  lessonType            String   @default("MIXED")
  correctionMode        String   @default("IMMEDIATE")
  showTranslations      Boolean  @default(true)
  showGrammarTips       Boolean  @default(true)
  showPronunciationTips Boolean  @default(true)
  speakingPractice      Boolean  @default(true)
  autoPlayAudio         Boolean  @default(false)
  speechSpeed           Decimal  @default(1.00) @db.Decimal(3, 2)
  createdAt             DateTime @default(now()) @db.Timestamp(6)
  updatedAt             DateTime @default(now()) @updatedAt @db.Timestamp(6)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Chat {
  id        String    @id @default(cuid())
  title     String    @default("New conversation")
  userId    String
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_user")
  Message   Message[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  content   String
  role      MessageRole
  chatId    String
  createdAt DateTime    @default(now())
}

model UserApiLimit {
  id        String   @id @default(cuid())
  userId    String   @unique
  count     BigInt   @default(0)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_api_limit_user")
}

model UserSubscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  stripeCustomerId       String?
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
}

model Message {
  id        String   @id
  role      String
  content   String
  chatId    String
  createdAt DateTime @default(now()) @db.Timestamp(6)
  Chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_message_chat")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}
